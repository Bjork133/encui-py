Screen {
    background: $surface;
}

#banner {
    color: $accent;
    text-style: bold;
    padding: 0 2;
    height: auto;
}

#workspace {
    layout: horizontal;
    height: 1fr;
    padding: 0 1;
}

.panel {
    border: round $primary;
    padding: 1 2;
    margin: 0 1;
    height: 1fr;
}

#left-panel {
    width: 44%;
    min-width: 34;
    height: 1fr;
    overflow-y: auto;
}

#left-panel > Vertical,
#left-panel > Horizontal {
    height: auto;
}

#right-panel {
    width: 56%;
    min-width: 38;
    height: 1fr;
    overflow-y: hidden;
}

TabPane {
    height: 1fr;
    padding: 0;
}

.tab-scroll {
    height: 1fr;
    overflow-y: auto;
    padding-right: 1;
}

.section-title {
    text-style: bold;
    color: $secondary;
    margin-top: 1;
    margin-bottom: 1;
}

.section-title-first {
    text-style: bold;
    color: $secondary;
    margin-bottom: 1;
}

.field-label {
    margin-top: 1;
    color: $text-muted;
}

.hidden {
    display: none;
}

RadioSet {
    layout: horizontal;
    height: auto;
    border: none;
    padding: 0;
}

#data-input {
    height: 1fr;
    min-height: 6;
    margin-top: 1;
}

#result-hex, #result-utf8 {
    height: 5;
    margin-top: 1;
}

.btn-row {
    height: auto;
    margin-top: 1;
}

.file-row {
    height: auto;
    margin-top: 1;
}

.file-row Input {
    width: 1fr;
    margin-right: 1;
}

Button {
    margin-right: 1;
}

#status-bar {
    height: 3;
    border: round $accent;
    padding: 0 2;
    margin: 0 2 1 2;
    content-align: left middle;
}

HelpScreen {
    align: center middle;
    background: $background 65%;
}

#help-dialog {
    width: 80;
    max-width: 92%;
    height: auto;
    border: thick $accent;
    background: $panel;
    padding: 1 2;
}

#help-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#help-body {
    margin-bottom: 1;
}
